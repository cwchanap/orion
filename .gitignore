# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Raw ElevenLabs source takes are kept in private storage, not tracked publicly
/assets/audio/sources/
/assets/audio/music_sources/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Widget Preview related
.widget_preview/

# Keep raw verification output under verification-output/; publish only selected evidence.
/verification-output/
